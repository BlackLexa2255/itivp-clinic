{
  "info": {
    "name": "Клиника — безопасное REST API (ipr21)",
    "description": "Коллекция для проверки API индивидуальной практической работы 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Аутентификация",
      "item": [
        {
          "name": "Регистрация",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Создаёт пользователя с ролью user",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@clinic.by\",\n  \"password\": \"Patient#2026\"\n}"
            }
          }
        },
        {
          "name": "Вход (сохраняет токен)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Возвращает JWT и сохраняет его в переменную token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@clinic.by\",\n  \"password\": \"User#2026\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); }",
                  "pm.test('Статус 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Вход администратора",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Токен администратора",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@clinic.by\",\n  \"password\": \"Admin#2026\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); }",
                  "pm.test('Статус 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
